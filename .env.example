# Application Settings
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Kurunegala Furnitures"

# Database Configuration (Future MSSQL Setup)
# Replace these with your actual database credentials in your local .env file.
# DO NOT COMMIT REAL CREDENTIALS TO GITHUB.
